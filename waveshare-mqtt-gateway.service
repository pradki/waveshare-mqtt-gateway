[Unit]
Description=Waveshare Relay MQTT Gateway
After=network.target

[Service]
Type=simple
User=sqna
WorkingDirectory=/home/sqna/cave/raspberry/waveshare-mqtt-gateway
ExecStart=/home/sqna/venv/cave/bin/python /home/sqna/cave/raspberry/waveshare-mqtt-gateway/main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
