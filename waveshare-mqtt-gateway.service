[Unit]
Description=Waveshare Relay MQTT Gateway
After=network.target

[Service]
Type=simple
User=sqna
WorkingDirectory=/home/sqna/waveshare-mqtt-gateway
ExecStart=/home/sqna/venv/waveshare-mqtt-gateway/bin/python /home/sqna/waveshare-mqtt-gateway/main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
